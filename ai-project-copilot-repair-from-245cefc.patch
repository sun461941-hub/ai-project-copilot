-import json
-import re
-from dataclasses import asdict, dataclass
-from pathlib import Path
-
-
-@dataclass(frozen=True)
-class Finding:
-    severity: str
-    code: str
-    path: str
-    message: str
-
-
-@dataclass(frozen=True)
-class GuardReport:
-    score: int
-    findings: list[Finding]
