# Offline validation, ranking, audit, eval, and packaging helpers require no
# environment variables, API keys, or external services.
#
# The optional live OpenAI Responses budget gateway reads the key only from the
# process environment. Never commit a real value to this file.
OPENAI_API_KEY=

# Optional for organizations that need explicit request scoping.
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
